---
// Oval "bubble" card: image, floating title pill, price underneath.
import { ui, tr, sm, programUrl, type Lang, type Program } from '../lib/i18n';
const { program: p, lang, area } = Astro.props as { program: Program; lang: Lang; area?: string };
const t = ui[lang].programs;
const img = p.images[0];
const duration = tr(p.duration, lang);
---
<a class="bubble reveal" href={programUrl(p.slug, lang)} style={area ? `--area:${area}` : undefined}>
  <span class="bubble-img">
    {img && <img src={sm(img)} srcset={`${sm(img)} 640w, ${img} 1600w`} sizes="(min-width: 1000px) 280px, 45vw"
      alt="" width="640" height="780" loading="lazy" decoding="async" />}
    {duration && <span class="bubble-chip">{duration}</span>}
  </span>
  <span class="bubble-title">{tr(p.title, lang)}</span>
  {p.price && <span class="bubble-meta">{t.from} <b dir="ltr">{p.price}</b></span>}
</a>
