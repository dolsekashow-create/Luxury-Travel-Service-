};
const FILLED: Record<string, string> = {
  whatsapp:
    '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 1.8a8.200 8.200 0 1 1-4.300 15.200l-.3-.2-3 .8.8-2.900-.2-.3A8.200 8.200 0 0 1 12 3.800zM8.500 7.300c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.300s1 2.700 1.100 2.900c.2.2 2 3.200 5 4.400 2.500 1 3 .8 3.500.7.5 0 1.700-.7 2-1.400.2-.7.2-1.200.1-1.400l-.4-.3-1.800-.9c-.3-.1-.5-.1-.7.2l-.8 1c-.1.2-.3.2-.6.1a6.700 6.700 0 0 1-3.300-2.900c-.3-.4.2-.4.7-1.300.1-.2 0-.4 0-.5l-.9-2c-.2-.5-.4-.5-.6-.5z"/>',
};
const { name, size = 20 } = Astro.props;
const filled = name in FILLED;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="icon"
  fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={FILLED[name] ?? OUTLINE[name] ?? ''} />
